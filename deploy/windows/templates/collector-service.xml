<service>
  <id>KKPriceWatchCollector</id>
  <name>KK PriceWatch Collector</name>
  <description>External collection service for kk.pricewatch</description>
  <executable>{{PYTHON_EXE}}</executable>
  <arguments>-m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000</arguments>
  <workingdirectory>{{REPOSITORY_DIR}}</workingdirectory>
  <env name="KK_PRICEWATCH_API_TOKEN_FILE" value="{{TOKEN_FILE}}" />
  <env name="KK_PRICEWATCH_CHROME_BINARY" value="{{CHROME_BINARY}}" />
  <env name="KK_PRICEWATCH_BROWSER_DATA_DIR" value="{{BROWSER_DATA_DIR}}" />
  <env name="KK_PRICEWATCH_SELENIUM_CACHE_DIR" value="{{SELENIUM_CACHE_DIR}}" />
  <env name="SE_CACHE_PATH" value="{{SELENIUM_CACHE_DIR}}" />
  <env name="SE_OFFLINE" value="true" />
  <env name="SE_AVOID_STATS" value="true" />
  <env name="SE_AVOID_BROWSER_DOWNLOAD" value="true" />
  <env name="KK_PRICEWATCH_BROWSER_PREFLIGHT" value="true" />
  <startmode>Automatic</startmode>
  <autoRefresh>false</autoRefresh>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <stoptimeout>15 sec</stoptimeout>
</service>
